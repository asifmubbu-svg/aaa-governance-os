# Copy to .env for local Postgres, or set these in Render's Environment tab.
# Leave DATABASE_URL unset locally to use the built-in SQLite file (data/governance.db).

# Neon Postgres connection string (Render production). Example:
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT signing secret. MUST be a long random string in production.
# On Render this is auto-generated by render.yaml (generateValue).
GOV_SECRET=change-me-to-a-long-random-string

# Password set on the seeded demo accounts (asif@aaabed.com, etc.) at first seed.
GOV_DEFAULT_PASSWORD=AAA@govos2026

# Set to "production" on the host (enables secure cookies). Leave unset locally.
NODE_ENV=

# AI assistant (Groq). Free key from https://console.groq.com. Optional.
GROQ_API_KEY=
# Model id - override if Groq deprecates the default.
GROQ_MODEL=openai/gpt-oss-120b

# Port (Render sets this automatically; default 4000 locally).
PORT=4000
